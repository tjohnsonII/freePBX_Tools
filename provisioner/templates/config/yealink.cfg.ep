#!version:1.0.0.1

# Generated by provisioner-lab for <%= $device->{mac} %>
local_time.time_zone = -5
local_time.time_zone_name = United States-Eastern
local_time.ntp_server1 = pool.ntp.org

# Device
device.label = <%= $device->{label} // $device->{mac} %>

# Account 1
account.1.enable = 1
account.1.label = <%= $device->{display_name} // $device->{extension} // '' %>
account.1.display_name = <%= $device->{display_name} // '' %>
account.1.user_name = <%= $device->{sip_user} // $device->{extension} // '' %>
account.1.auth_name = <%= $device->{sip_user} // $device->{extension} // '' %>
account.1.password = <%= $device->{sip_password} // '' %>
account.1.sip_server.1.address = <%= $device->{sip_server} // '' %>
account.1.sip_server.1.port = <%= $device->{sip_port} // 5060 %>
