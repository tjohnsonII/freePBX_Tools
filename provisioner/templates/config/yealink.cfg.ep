#!version:1.0.0.1

# Generated by provisioner-lab for <%= $device->{mac} %>
local_time.time_zone = -5
local_time.time_zone_name = United States-Eastern
local_time.ntp_server1 = pool.ntp.org

# Device
device.label = <%= $device->{label} // $device->{mac} %>

# Arbitrary attributes (editable via the admin UI)
% for my $attr (@$attributes) {
<%= $attr->{attr_key} %> = <%= $attr->{attr_value} // '' %>
% }

# Phone web-UI / management login (not the SIP account above)
static.security.user_password = admin:<%= $c->phone_admin_password %>
