<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by provisioner-lab for <%= $device->{mac} %> -->
<polycomConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="polycomConfig.xsd">
  <reg
      reg.1.address="<%= Mojo::Util::xml_escape($device->{sip_user} // $device->{extension} // '') %>"
      reg.1.label="<%= Mojo::Util::xml_escape($device->{display_name} // $device->{label} // $device->{extension} // $device->{mac}) %>"
      reg.1.displayName="<%= Mojo::Util::xml_escape($device->{display_name} // $device->{label} // $device->{extension} // $device->{mac}) %>"
      reg.1.auth.userId="<%= Mojo::Util::xml_escape($device->{sip_user} // $device->{extension} // '') %>"
      reg.1.auth.password="<%= Mojo::Util::xml_escape($device->{sip_password} // '') %>"
      reg.1.server.1.address="<%= Mojo::Util::xml_escape($device->{sip_server} // '') %>"
      reg.1.server.1.port="<%= $device->{sip_port} // 5060 %>"
  />
</polycomConfig>
